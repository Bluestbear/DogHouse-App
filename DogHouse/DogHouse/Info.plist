<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>DogHouse uses the camera so you can snap and send a photo during a Photo Dash.</string>
	<!-- Analytics starts OFF and is switched on by AnalyticsService.start(),
	     which reads the user's Profile → Share Usage Data choice. Without
	     this the SDK collects for the few milliseconds between
	     FirebaseApp.configure() and that call, which would make the opt-out
	     a promise the app doesn't quite keep. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Sign-In callback. This must stay identical to REVERSED_CLIENT_ID
	     in GoogleService-Info.plist — if you ever re-download that file and the
	     OAuth client changes, update this string to match or the sign-in flow
	     will complete in the browser and never return to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- doghouse://pair/CODE — used by the pairing web page's "Open in
		     DogHouse" button; universal links (applinks in the entitlements)
		     are the primary path. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.Harrison.DogHouse.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>doghouse</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.760271967405-g1bpceb39jqmoj733b31vfqrltpagsbk</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
