rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    // displayName goes into other users' push text, so it is a bounded string.
    // The client caps names at 40 characters; the bound here is generous
    // because size() does not count grapheme clusters, and an accented or
    // emoji name that the client accepted must not be denied.
    function validDisplayName() {
      return !('displayName' in request.resource.data)
        || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 160);
    }

    function myPartnerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('partnerId', null);
    }

    // A coupleKey is "uidA_uidB" sorted. Membership means: I am one half AND
    // the other half is genuinely my current partner. Checking only that my
    // uid appears in the key let anyone fabricate a couple doc keyed to a
    // stranger's uid.
    //
    // This trusts my own partnerId, which the /users rule only lets me point
    // at someone who already points back. A reciprocal check here would be
    // stricter still, but a listener attached while one half has just
    // unpaired would be denied and never recover, so it stays one-sided.
    function isMyCoupleKey(coupleKey) {
      let parts = coupleKey.split('_');
      return parts.size() == 2
        && request.auth.uid in parts
        && (parts[0] == request.auth.uid ? parts[1] : parts[0]) == myPartnerId();
    }

    // "uidA_uidB" for a two-element list, sorted like coupleKeyOf.
    function coupleKeyOfPair(ids) {
      return ids[0] < ids[1] ? ids[0] + '_' + ids[1] : ids[1] + '_' + ids[0];
    }

    // Profiles are readable ONE DOCUMENT AT A TIME by any authenticated
    // user — partner and friend-couple lookups fetch by known uid and need
    // displayName/avatarId/cosmetics.
    //
    // `list` is denied. Allowing it would let any signed-in account walk the
    // entire user table; queries must therefore fetch by document id
    // (see FriendService.fetchProfiles).
    //
    // Secrets never live on this document: fcmToken and partnerCode are in
    // the owner-only /private/data subdocument below.
    //
    // Economy fields (treats, graceCharges, immunityUntil, wishCards,
    // ownedItemIds, lastTreatAward) are SERVER-ONLY: clients cannot change
    // them, so they can't self-grant currency, immunity, cards, or items.
    // All economy mutations go through callable Cloud Functions which run
    // with admin privileges and bypass these rules.
    match /users/{userId} {
      allow get: if authed();
      allow list: if false;
      // Create is the one write the update denylist below does not cover, so
      // it gets its own: a new profile carries no balance, cards, immunity,
      // items or secrets (every reader defaults them — treats to 100), at
      // most the starting grace, and no partner. Without this a fresh
      // account could create its profile already holding any balance it
      // liked. Mirrors AuthService.bootstrapProfileIfNeeded.
      allow create: if authed()
        && request.auth.uid == userId
        && !request.resource.data.keys()
             .hasAny(['treats', 'immunityUntil', 'wishCards', 'ownedItemIds',
                      'equippedItemIds', 'lastTreatAward', 'fcmToken',
                      'partnerCode', 'premiumUntil', 'premiumProductId',
                      'premiumUpdatedAt'])
        && validDisplayName()
        && request.resource.data.get('graceCharges', 3) == 3
        && request.resource.data.get('partnerId', null) in [null, 'skipped'];

      // Owner may update only non-economy fields, and may never (re)introduce
      // the relocated secrets. Removing them is allowed — that is exactly what
      // the one-time migration in AuthService.migrateLegacyPrivateFields does,
      // since the resulting document contains neither key.
      allow update: if authed()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['treats', 'graceCharges', 'immunityUntil', 'wishCards',
                      'ownedItemIds', 'equippedItemIds', 'lastTreatAward',
                      'lastGraceRecharge', 'createdAt', 'premiumUntil',
                      'premiumProductId', 'premiumUpdatedAt'])
        && !request.resource.data.keys().hasAny(['fcmToken', 'partnerCode'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || validDisplayName())
        // partnerId: a client may clear it, skip, or name someone who already
        // points back. Only the pairWithCode callable can arrange the latter,
        // so pairing always goes through the code check.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerId'])
            || request.resource.data.get('partnerId', null) in [null, 'skipped']
            || get(/databases/$(database)/documents/users/$(request.resource.data.partnerId))
                 .data.get('partnerId', null) == request.auth.uid);
      // equippedItemIds is written by the equipCosmetic callable, which
      // checks ownership; a direct write would wear any hat unpaid.
      // premiumUntil / premiumProductId / premiumUpdatedAt are written only
      // by the RevenueCat webhook; createGame reads premiumUntil to lift the
      // daily game limit, so a client-set value would be free premium.
      //
      // createdAt is not a balance, but it picks the room level and so the
      // treat rate claimHomeTreats pays; backdating it bought the top rate.
      // (The server also clamps it to the Auth account's creation time.)
      //
      // Builds before 1.1 (6) paired by writing partnerId directly; they
      // must update to pair. Tests: "partnerId lockdown" in
      // firestore-tests/rules.test.js.

      // No partner write path: you can gift your partner a cosmetic (via
      // purchaseCosmetic) but only they decide whether their dog wears it.
    }

    // Owner-only private data: the push token and this account's pairing
    // code. These used to sit on the public /users document, where every
    // signed-in account could read them — a pairing code is enough to hijack
    // an unpaired user, and a push token is a device identifier.
    //
    // Cloud Functions read this with admin privileges (rules do not apply),
    // which is how notifyUser still resolves tokens.
    match /users/{userId}/private/{docId} {
      allow read: if authed() && request.auth.uid == userId;
      allow create: if authed() && request.auth.uid == userId;
      // partnerCode is issued once at sign-up and is immutable thereafter;
      // it is the key other users pair against.
      allow update: if authed()
        && request.auth.uid == userId
        && (!('partnerCode' in resource.data)
            || request.resource.data.get('partnerCode', null) == resource.data.partnerCode);
    }

    // A code can be looked up one at a time by anyone signed in (builds up
    // to 1.1 (5) resolve it client-side; later builds use pairWithCode and
    // never read here). `list` is denied: `allow read` used to include it,
    // and a collection query handed out every code and the uid behind it.
    // Create-only, and only for your own uid — codes never change.
    match /partnerCodes/{code} {
      allow get: if authed();
      allow list: if false;
      allow create: if authed() && request.resource.data.userId == request.auth.uid;
    }

    // Only the sender or receiver can see doghouse events. Creation and
    // updates are SERVER-ONLY (sendToDoghouse / releasePartner /
    // requestRedemption callables + the vote resolver) so grace charges
    // and immunity can't be bypassed by writing an event directly.
    match /doghouseEvents/{eventId} {
      allow read: if authed() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
      // no client create/update — callables use admin and bypass rules
    }

    // Couple-to-couple friendships: created/removed only by the
    // addCoupleFriend / removeCoupleFriend callables (server validates the
    // couple code and both pairings). Members can read their own links.
    match /coupleFriendships/{linkId} {
      allow read: if authed()
        && request.auth.uid in resource.data.memberIds;
    }

    // Reading requires being in the audience (joint votes) or the group
    // (legacy squad votes). The only client write allowed is casting your
    // own vote while the event is active — creation of joint votes and
    // resolution/release are server-side.
    // Votes are created only by the server (jailbreak detection). Audience
    // members can read and may only cast their own vote while active —
    // audience-only checks keep the array-contains listener provable.
    match /voteEvents/{voteId} {
      allow read: if authed()
        && request.auth.uid in resource.data.get('audienceIds', []);
      // The vote must name one of the dogs in this vote. Without that check
      // anyone in the audience could vote for themselves (or their partner)
      // and, on winning, be "released" with an hour of immunity.
      allow update: if authed()
        && resource.data.status == 'active'
        && request.auth.uid in resource.data.get('audienceIds', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.votes[request.auth.uid] in resource.data.get('doghousedUserIds', [])
        // One vote each, cast before endsAt. The resolver only runs once a
        // minute, so "status still active" left a window after the deadline
        // in which late votes — or changed ones — still counted.
        && !(request.auth.uid in resource.data.get('votes', {}))
        && request.time < resource.data.endsAt;
    }

    // Public sendings. Readable by the audience. Creation and release are
    // SERVER-ONLY (sendToDoghouse / releasePartner callables) so a post
    // can't exist without a validated doghouse event. Audience members may
    // only add/change their own key in `reactions` or `roasts`.
    match /feedPosts/{postId} {
      allow read: if authed()
        && request.auth.uid in resource.data.audienceIds;
      allow update: if authed()
        && request.auth.uid in resource.data.audienceIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'roasts'])
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('roasts', {}).diff(resource.data.get('roasts', {})).affectedKeys().hasOnly([request.auth.uid])
        // Values, not just keys: a reaction is one of the two kinds, and a
        // roast is short text (the app sends canned lines; the push trigger
        // only forwards those). Removing your own entry is always allowed.
        && (!(request.auth.uid in request.resource.data.get('reactions', {}))
            || request.resource.data.reactions[request.auth.uid] in ['back', 'dog'])
        && (!(request.auth.uid in request.resource.data.get('roasts', {}))
            || (request.resource.data.roasts[request.auth.uid] is string
                && request.resource.data.roasts[request.auth.uid].size() <= 60))
        // The couple in the post don't react to or roast their own sending:
        // they can't add or change their entry, only clear an old one.
        && (!(request.auth.uid in [resource.data.senderId, resource.data.receiverId])
            || !(request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).addedKeys()
                   .union(request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).changedKeys())
                   .union(request.resource.data.get('roasts', {}).diff(resource.data.get('roasts', {})).addedKeys())
                   .union(request.resource.data.get('roasts', {}).diff(resource.data.get('roasts', {})).changedKeys())
                   .hasAny([request.auth.uid])));
    }

    // Feedback (complaints/suggestions) — create-only, as yourself. The
    // onFeedbackCreated Cloud Function emails it to the developer.
    // Bounded like reports; onFeedbackCreated also caps emails per user.
    match /feedback/{feedbackId} {
      allow create: if authed()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.keys().hasOnly(['fromUserId', 'fromName', 'type', 'text', 'createdAt'])
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() <= 2000
        && request.resource.data.get('fromName', '') is string
        && request.resource.data.get('fromName', '').size() <= 100
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('type', '').size() <= 40;
    }

    // Content reports — create-only, as yourself. onReportCreated emails the
    // developer. Never readable by clients (a report names other users).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if authed()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['feedPost', 'user', 'photo']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100
        && request.resource.data.get('details', '').size() <= 1000;
    }

    // Block list — one doc per user, readable by its owner (the feed and
    // friends list filter on it). Written only by the blockUser /
    // unblockUser callables, which also sever the couple friendship.
    match /blocks/{userId} {
      allow read: if authed() && request.auth.uid == userId;
      allow write: if false;
    }

    // Account deletion requests — write-only marker for your own uid;
    // the onDeletionRequest Cloud Function does the actual cleanup.
    match /deletionRequests/{userId} {
      allow create: if authed() && request.auth.uid == userId;
    }

    // Only the two partners in the couple can access their onboarding doc.
    //
    // Path-based (like coupleTasks below) rather than resource-based, and
    // that difference is load-bearing: OnboardingService attaches its
    // snapshot listener when the negotiation screen opens, which is BEFORE
    // either partner has submitted, so before the document exists. On a
    // missing document `resource` is null, so a rule reading
    // resource.data.user1Id evaluates to a denial — and Firestore tears down
    // a listener that takes permission-denied instead of retrying it. Both
    // partners then sat on "waiting for your partner" forever, because
    // neither client ever received the other's submission.
    //
    // Writes are split per partner: the doc holds two halves (user1*, user2*,
    // user1 = the lower uid, as in OnboardingService.sortedIds) and each
    // partner may only write their own half. Either could previously set the
    // other's Submitted/Confirmed flags and finalize for both. finalTasks is
    // shared — both clients compute the identical list — so it is
    // write-once, and only after both reviews are in.
    match /onboardingTasks/{coupleKey} {
      allow read: if authed() && isMyCoupleKey(coupleKey);
      allow create: if authed() && isMyCoupleKey(coupleKey)
        && onboardingWriteOk(coupleKey, request.resource.data.keys(), []);
      allow update: if authed() && isMyCoupleKey(coupleKey)
        && onboardingWriteOk(coupleKey,
             request.resource.data.diff(resource.data).affectedKeys(),
             resource.data.get('finalTasks', []));
    }

    function onboardingWriteOk(coupleKey, changed, existingFinal) {
      let parts = coupleKey.split('_');
      let slot = parts[0] == request.auth.uid ? 'user1' : 'user2';
      let d = request.resource.data;
      return changed.hasOnly(['id', 'coupleId', 'user1Id', 'user2Id', 'finalTasks',
                              slot + 'Tasks', slot + 'Submitted', slot + 'Strikes',
                              slot + 'ReviewComplete', slot + 'Confirmed'])
        && d.get('id', coupleKey) == coupleKey
        && d.get('coupleId', coupleKey) == coupleKey
        && d.get('user1Id', parts[0]) == parts[0]
        && d.get('user2Id', parts[1]) == parts[1]
        && (!changed.hasAny(['finalTasks'])
            || (existingFinal.size() == 0
                && d.get('user1ReviewComplete', false) == true
                && d.get('user2ReviewComplete', false) == true));
    }

    // Couple tasks — keyed by coupleKey (uid1_uid2 sorted); only the two
    // partners whose uids form the key can access it.
    match /coupleTasks/{coupleKey} {
      allow read, write: if authed() && isMyCoupleKey(coupleKey);
    }

    // Couple metadata (anniversary date) — only the two partners whose
    // uids form the coupleKey can access it.
    match /coupleMeta/{coupleKey} {
      allow read, write: if authed() && isMyCoupleKey(coupleKey);
    }

    // Couple achievements — unlocked badges and the roses / belly-rub
    // counters. Nothing economic lives here, so the partners write it
    // directly. Path-based like its neighbours: the listener attaches before
    // the first badge exists.
    match /achievements/{coupleKey} {
      allow read, create, update: if authed() && isMyCoupleKey(coupleKey);
    }

    // Play-tab game stats (wins, card meter, weekly card count, and
    // createGame's daily-limit counter lastGameDay / gamesToday) and the
    // "redo our tasks" request. SERVER-ONLY: answerGame and
    // taskRenegotiation write them with admin privileges, and the card meter
    // pays Whatever-I-Want cards, so no client write of any kind. Path-based
    // like coupleMeta/achievements: the listeners attach before the first
    // game is played or the first request made.
    match /gameStats/{coupleKey} {
      allow read: if authed() && isMyCoupleKey(coupleKey);
      allow write: if false;
    }

    match /taskRenegotiation/{coupleKey} {
      allow read: if authed() && isMyCoupleKey(coupleKey);
      allow write: if false;
    }

    // Couple challenges (quiz / photo dash / anniversary race / Play game).
    // Play games (type "game") are created and answered ONLY by the
    // createGame / answerGame callables: the create rule admits the
    // anniversary race only, and the update rule quiz answers and photo
    // claims only, so neither matches a game. Quizzes are no longer
    // client-created (it bypassed createGame's daily game limit); answering
    // an existing legacy quiz still is.
    // Participants only; a completed challenge is immutable from clients
    // (which is what makes the anniversary race first-tap-wins), and
    // cardAwarded can only ever be set server-side.
    match /challenges/{challengeId} {
      // `resource == null`: the anniversary race reads this year's doc before
      // creating it. Without the guard that get is denied (a rule that reads
      // resource.data denies on a missing doc) and the race could never be
      // won. A read of a document that does not exist reveals nothing.
      allow read: if authed()
        && (resource == null || request.auth.uid in resource.data.participants);
      //
      // A client may create only this year's anniversary race (completed at
      // birth, won by its creator, at the deterministic id ChallengeService
      // uses), for my own couple. Client quiz creation was removed: it was a
      // route around createGame's server-side daily game limit. The create used to accept any completed challenge
      // naming its creator winner, and onChallengeWritten paid a card for
      // each — unlimited cards. The trigger now checks provenance too.
      allow create: if authed()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.coupleKey == coupleKeyOfPair(request.resource.data.participants)
        && isMyCoupleKey(request.resource.data.coupleKey)
        && !request.resource.data.keys().hasAny(['cardAwarded', 'photoData'])
        && anniversaryCreate(challengeId);
      // While active, a participant may answer a quiz (their OWN key in
      // `answers` only, or either partner could rewrite the other's answer to
      // force a match) or claim a photo dash for themselves.
      allow update: if authed()
        && request.auth.uid in resource.data.participants
        && resource.data.status == 'active'
        && (quizAnswer() || photoClaim());
    }

    // A Play game's hidden answer. The partner must not read it before
    // guessing; only the callables (admin SDK) touch it.
    match /challenges/{challengeId}/private/{docId} {
      allow read, write: if false;
    }

    // The id carries the year; local time can be up to 14h either side of
    // UTC, so either neighbouring year is accepted around New Year.
    function anniversaryCreate(challengeId) {
      let d = request.resource.data;
      let prefix = 'anniv_' + d.coupleKey + '_';
      return d.type == 'anniversary'
        && d.status == 'completed'
        && d.winnerId == request.auth.uid
        && !d.keys().hasAny(['answers'])
        && challengeId in [
             prefix + string((request.time - duration.value(14, 'h')).year()),
             prefix + string((request.time + duration.value(14, 'h')).year())];
    }

    function quizAnswer() {
      return resource.data.type == 'quiz'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
        && request.resource.data.get('answers', {}).diff(resource.data.get('answers', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // First photo in wins; the claim names its sender as winner. Photo
    // dashes themselves are created only by the randomPhotoDash scheduler.
    function photoClaim() {
      let d = request.resource.data;
      return resource.data.type == 'photo'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'winnerId', 'photoData', 'completedAt'])
        && d.status == 'completed'
        && d.winnerId == request.auth.uid
        && d.get('photoData', '') is string
        && d.get('photoData', '').size() <= 400000;
    }

    // Redeemed "Whatever I Want" cards. Creation is SERVER-ONLY (the
    // redeemWishCard callable checks and decrements the card balance); a
    // client create used to bypass the economy entirely. The receiver can
    // mark a wish fulfilled.
    match /wishes/{wishId} {
      allow read: if authed() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow update: if authed()
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfilled']);
    }

    // Roses — doc id is the receiver's uid. Written only by the sendRoses
    // callable (it costs treats). The receiver reads for their bouquet;
    // their partner (the sender) reads to see the bouquet on the
    // partner's scene too.
    match /roses/{userId} {
      allow read: if authed() && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(userId)).data.partnerId == request.auth.uid
      );
    }

    // Session history — one row per app open, used only to see how often
    // people come back. Create-only and never readable by any client: it is
    // a per-user activity trail, so exposing it would be exactly the kind of
    // cross-user enumeration `allow list: if false` on /users exists to stop.
    // Read it from the Firebase console; cleanupSessions prunes it.
    match /sessions/{sessionId} {
      allow read, update, delete: if false;
      allow create: if authed()
        && request.resource.data.userId == request.auth.uid;
    }

    // Belly rubs — doc id is the receiver's uid. The receiver reads
    // (their own incoming-rub listener); only their partner can send, and
    // must stamp the write with their own uid so the display name shown in
    // the recipient's toast cannot be spoofed.
    match /bellyRubs/{userId} {
      allow read: if authed() && request.auth.uid == userId;
      allow write: if authed()
        && get(/databases/$(database)/documents/users/$(userId)).data.partnerId == request.auth.uid
        && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
