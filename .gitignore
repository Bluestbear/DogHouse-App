# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Secrets — APNs auth keys must never be committed
Keys/
*.p8

# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate

# Compiled functions output (rebuilt by predeploy)
functions/lib/
DogHouse/functions/lib/

# Local archives
build/

# Claude Code local config
.claude/

# VS Code local config
.vscode/
*.code-workspace

# Local working files (launch video output, marketing scratch, QA runs)
DogHouse/brag-output/
Marketing/App Images/
Marketing/Neuer Ordner.zip
QA-Run-*/

# Contest submission working files
Shipaton/

# Firebase client config: every developer downloads their own
# (see README "Configuration"). Ignoring does not untrack a file that is
# already tracked.
GoogleService-Info*.plist
# Functions secrets and legacy runtime config for the emulator
**/.secret.local
**/.runtimeconfig.json
# Service-account keys
*service-account*.json
serviceAccount*.json
# Emulator exports can hold user data
emulator-data/
firebase-export-*/

# Marketing reference material, not part of the source release
Marketing/
